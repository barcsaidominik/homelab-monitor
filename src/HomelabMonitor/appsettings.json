{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:5556" }
    }
  },
  "Seq": {
    "Url": "",
    "Application": "HomelabMonitor"
  },
  "Monitor": {
    "DataDir": "C:\\ProgramData\\HomelabMonitor",
    "RunBackground": true,
    "TimeZone": "UTC",
    "CycleSeconds": 60
  },
  "Probes": {
    "Enabled": true,
    "TimeoutSeconds": 8
  },
  "Notify": {
    "Enabled": false
  },
  "Heartbeat": {
    "Enabled": false
  },
  "Homepage": {
    "Enabled": false
  }
}
