{
  "Seq": {
    "Url": "http://127.0.0.1:5341",
    "Application": "Homelab"
  },
  "Monitor": {
    "DataDir": "C:\\ProgramData\\HomelabMonitor",
    "TimeZone": "Europe/Berlin",
    "Heavy": {
      "Directory": "C:\\ProgramData\\HomelabMonitor\\heavy",
      "StaleHours": 7,
      "MaxAgeHours": 12
    },
    "Maintenance": {
      "PostBootMinutes": 10,
      "Windows": [
        { "Day": "Wednesday", "Start": "02:00", "End": "03:30" },
        { "Day": "Saturday", "Start": "05:45", "End": "06:30" }
      ]
    },
    "Reports": {
      "Enabled": true,
      "At": "07:00",
      "WeeklyDay": "Monday",
      "Disks": [ "C", "D" ],
      "Uptime": [
        { "Key": "media", "Name": "Media server", "Check": "http.media" },
        { "Key": "cloud", "Name": "File cloud", "Check": "http.cloud" }
      ],
      "Backups": [
        { "Name": "Nightly backup", "Check": "backup.daily" }
      ],
      "Values": [
        { "Name": "Failed jobs (24 h)", "Check": "jobs.failures" }
      ]
    }
  },
  "Probes": {
    "Enabled": true,
    "TimeoutSeconds": 8,
    "LanAddress": "192.0.2.10",
    "Http": [
      { "CheckId": "http.media", "Url": "https://media.home.example.net/health", "ExpectBody": "Healthy", "ForceLan": true },
      { "CheckId": "http.cloud", "Url": "https://cloud.home.example.net/status.php", "ForceLan": true },
      { "CheckId": "http.dashboard", "Url": "https://home.example.net/", "MaxStatus": 399, "ForceLan": true }
    ],
    "Dns": [
      { "CheckId": "dns.local", "Server": "192.0.2.10", "Names": [ "home.example.net", "media.home.example.net" ] },
      { "CheckId": "dns.vpn", "Server": "192.0.2.53", "Names": [ "home.example.net" ] }
    ],
    "Tls": [
      { "CheckId": "svc.proxy", "Address": "192.0.2.10", "Port": 443, "Sni": "home.example.net" }
    ],
    "Services": {
      "svc.dns": "DnsService",
      "svc.vpn": "Tailscale"
    },
    "Processes": {
      "proc.media": "jellyfin",
      "proc.docker": "com.docker.backend"
    },
    "JsonApi": [
      {
        "Url": "http://127.0.0.1:5555/api/status",
        "IntervalMinutes": 5,
        "Thresholds": [
          { "CheckId": "jobs.failures", "Field": "failed24h", "WarnAtOrAbove": 3, "Message": "{value} failed jobs in 24 h" }
        ],
        "Stall": {
          "CheckId": "jobs.stuck",
          "ActiveField": "activeJobs",
          "ProgressField": "currentJob.progressPercent",
          "KeyFields": [ "currentJob.name", "currentJob.worker" ],
          "PausedField": "status",
          "PausedValue": "paused",
          "Minutes": 30
        }
      }
    ],
    "FanState": {
      "Enabled": true,
      "StatePath": "C:\\ProgramData\\FanController\\state.json",
      "FanCheckId": "thermal.fan",
      "CpuCheckId": "thermal.cpu"
    }
  },
  "Notify": {
    "Enabled": false,
    "BaseUrl": "https://ntfy.sh",
    "TopicFile": "C:\\ProgramData\\HomelabMonitor\\secrets\\ntfy.topic",
    "Prefix": "[Homelab]",
    "Rules": {
      "unreachable": { "Body": "{names} is unreachable", "ReminderAfterHours": 6, "WithDuration": true },
      "backup": { "Body": "no successful backup for 26+ hours", "Daily": true },
      "disk": { "Body": "low disk space or disk problem: {names}", "Daily": true, "WithDuration": true }
    }
  },
  "Heartbeat": {
    "Enabled": false,
    "UrlFile": "C:\\ProgramData\\HomelabMonitor\\secrets\\heartbeat.url"
  },
  "Homepage": {
    "Enabled": true
  },
  "Catalog": {
    "Checks": {
      "svc.dns": { "DisplayName": "DNS service", "FailThreshold": 2, "RecoverThreshold": 2, "OnError": "Crit" },
      "dns.local": { "DisplayName": "DNS", "FailThreshold": 2, "RecoverThreshold": 3, "OnError": "Crit", "Parents": [ "svc.dns" ], "NotifyRule": "unreachable" },
      "svc.vpn": { "DisplayName": "VPN service", "FailThreshold": 3, "RecoverThreshold": 3 },
      "dns.vpn": { "DisplayName": "DNS (VPN)", "FailThreshold": 3, "RecoverThreshold": 3, "Parents": [ "svc.vpn" ] },
      "svc.proxy": { "DisplayName": "Reverse proxy (443)", "FailThreshold": 2, "RecoverThreshold": 2, "OnError": "Crit" },
      "proc.media": { "DisplayName": "Media server process", "FailThreshold": 2, "RecoverThreshold": 2 },
      "http.media": { "DisplayName": "Media server", "FailThreshold": 3, "RecoverThreshold": 3, "OnError": "Crit", "Parents": [ "dns.local", "svc.proxy", "proc.media" ], "NotifyRule": "unreachable" },
      "proc.docker": { "DisplayName": "Docker", "FailThreshold": 2, "RecoverThreshold": 2 },
      "http.cloud": { "DisplayName": "File cloud", "FailThreshold": 3, "RecoverThreshold": 3, "OnError": "Crit", "Parents": [ "dns.local", "svc.proxy", "proc.docker" ], "NotifyRule": "unreachable" },
      "http.dashboard": { "DisplayName": "Dashboard", "FailThreshold": 3, "RecoverThreshold": 3, "Parents": [ "dns.local", "svc.proxy" ] },
      "jobs.failures": { "DisplayName": "Job failures" },
      "jobs.stuck": { "DisplayName": "Stuck job", "FailThreshold": 2 },
      "thermal.fan": { "DisplayName": "Fan", "FailThreshold": 2, "RecoverThreshold": 2, "OnError": "Crit" },
      "thermal.cpu": { "DisplayName": "CPU temperature", "FailThreshold": 3, "RecoverThreshold": 3 },
      "backup.daily": { "DisplayName": "Nightly backup", "Source": "Heavy", "OnError": "Crit", "NotifyRule": "backup" },
      "disk.free.C": { "DisplayName": "C: disk space", "Source": "Heavy", "OnError": "Crit", "NotifyRule": "disk" },
      "disk.free.D": { "DisplayName": "D: disk space", "Source": "Heavy", "OnError": "Crit", "NotifyRule": "disk" },
      "monitor.heavy.stale": { "DisplayName": "Heavy checks" },
      "monitor.check.broken": { "DisplayName": "Monitor self-check" }
    }
  }
}
